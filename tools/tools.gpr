with "config/zlib_tools_config.gpr";

project Tools is
   for Source_Dirs use (".", "fuzz", "config");
   for Object_Dir use "obj/" & Zlib_Tools_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use
     ("zlib_inflate_file.adb",
      "zlib_deflate_stored_file.adb",
      "zlib_deflate_fixed_file.adb",
      "zlib_deflate_dynamic_file.adb",
      "zlib_compress_file.adb",
      "gzip_file.adb",
      "gzip_metadata_file.adb",
      "zlib_streaming_roundtrip.adb",
      "gzip_streaming_roundtrip.adb",
      "raw_deflate_file.adb",
      "raw_inflate_file.adb",
      "raw_roundtrip.adb",
      "raw_vs_zlib_vs_gzip.adb",
      "zlib_bench_inflate.adb",
      "zlib_bench_deflate.adb",
      "zlib_bench_gzip.adb",
      "zlib_bench_raw.adb",
      "zlib_bench_matrix.adb",
      "smoke_test.adb",
      "seven_zip_interop_check.adb",
      "check_all.adb",
      "fuzz_inflate.adb",
      "fuzz_streaming_inflate.adb",
      "fuzz_compress_roundtrip.adb",
      "fuzz_compress_levels.adb",
      "fuzz_wrapper_mix.adb",
      "fuzz_dictionary.adb",
      "fuzz_gzip_metadata.adb",
      "fuzz_mutation.adb",
      "fuzz_flush.adb",
      "fuzz_lifecycle.adb",
      "fuzz_tiny_buffers.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Zlib_Tools_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;
   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Wb");
   end Binder;

end Tools;
