with "config/check_zlib_config.gpr";

project Check_Zlib is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Check_Zlib_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("check_zlib.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Check_Zlib_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Check_Zlib;
