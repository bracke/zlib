with "config/zlib_config.gpr";
project Zlib is

   for Library_Name use "Zlib";
   for Library_Version use Project'Library_Name & ".so." & Zlib_Config.Crate_Version;

   --  Zlib.Native_Files reaches the file system through the Win32 wide API on
   --  Windows (paths past MAX_PATH) and through the Ada libraries elsewhere.
   case Zlib_Config.Alire_Host_OS is
      when "windows" =>
         for Source_Dirs use ("src/", "config/", "src/platform/windows");
      when others =>
         for Source_Dirs use ("src/", "config/", "src/platform/posix");
   end case;
   for Object_Dir use "obj/" & Zlib_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("ZLIB_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   --  Stack checking, for a build that needs a stack overflow to raise
   --  Storage_Error every time: the test suite, which runs compression in a
   --  task with a small stack to prove it streams. Without -fstack-check an
   --  overflow is caught only when a frame touches the guard page, and a frame
   --  larger than the guard page can step over it into other memory. Off by
   --  default, so a consumer does not pay for the probes; tests/alire.toml
   --  turns it on.
   type Stack_Check_Type is ("true", "false");
   Stack_Check : Stack_Check_Type := external ("ZLIB_STACK_CHECK", "false");

   package Compiler is
      case Stack_Check is
         when "true" =>
            for Default_Switches ("Ada") use
              Zlib_Config.Ada_Compiler_Switches & ("-gnat2022","-gnatyM120","-gnatX", "-gnata", "-fstack-check");
         when "false" =>
            for Default_Switches ("Ada") use
              Zlib_Config.Ada_Compiler_Switches & ("-gnat2022","-gnatyM120","-gnatX", "-gnata");
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Zlib;
